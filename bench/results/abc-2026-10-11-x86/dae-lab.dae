global {
    wan_interface: ens3
    lan_interface: veth-lab
    log_level: info
    dial_mode: ip
    allow_insecure: true
    auto_config_kernel_parameter: true
    tcp_check_url: 'http://10.10.10.70:8080'
    tcp_check_http_method: HEAD
    udp_check_dns: '10.10.10.70:53539'
    check_interval: 3600s
    check_tolerance: 30ms
}

node {
    hy2: 'hysteria2://testpass123@10.10.10.70:8443/?insecure=1'
    tuic: 'tuic://00000000-0000-0000-0000-000000000001:testpass123@10.10.10.70:2444/?congestion_control=cubic&alpn=tuic&sni=hy2.test&insecure=1'
    ss2022: 'ss://2022-blake3-aes-128-gcm:8JCsHssyVTFyPy5lYdNhZg==@10.10.10.70:2447'
    trojan: 'trojan://testpass123@10.10.10.70:2446/?sni=hy2.test&allowInsecure=1'
    anytls-sb: 'anytls://testpass123@10.10.10.70:2445/?insecure=1'
    anytls-go: 'anytls://testpass123@10.10.10.70:2443/?insecure=1'
}

group {
    proxy-hy2 {
        filter: name('hy2')
        policy: fixed(0)
    }
    proxy-tuic {
        filter: name('tuic')
        policy: fixed(0)
    }
    proxy-ss2022 {
        filter: name('ss2022')
        policy: fixed(0)
    }
    proxy-trojan {
        filter: name('trojan')
        policy: fixed(0)
    }
    proxy-anytls-sb {
        filter: name('anytls-sb')
        policy: fixed(0)
    }
    proxy-anytls-go {
        filter: name('anytls-go')
        policy: fixed(0)
    }
}

routing {
    dport(8443, 2443, 2444, 2445, 2446, 2447) -> direct(must)
    dport(5201, 8001, 53531) -> proxy-hy2
    dport(5202, 8002, 53532) -> proxy-tuic
    dport(5203, 8003, 53533) -> proxy-ss2022
    dport(5204, 8004, 53534) -> proxy-trojan
    dport(5205, 8005, 53535) -> proxy-anytls-sb
    dport(5206, 8006, 53536) -> proxy-anytls-go
    fallback: direct
}

dns {
    upstream {
        alidns: 'udp://223.5.5.5:53'
    }
    routing {
        request {
            fallback: alidns
        }
    }
}
