global {
    wan_interface: ens3
    lan_interface: veth-lab
    log_level: info
    dial_mode: ip
    allow_insecure: true
    auto_config_kernel_parameter: true
    tcp_check_url: 'http://cp.cloudflare.com,1.1.1.1,2606:4700:4700::1111'
    tcp_check_http_method: HEAD
    udp_check_dns: 'dns.google.com:53,8.8.8.8,2001:4860:4860::8888'
    check_interval: 3600s
    check_tolerance: 30ms
    udp_warm_node_count: 8
}

node {
    vless-vision: 'vless://4a3d42a2-a62d-4454-b2a2-7cbe5ddf4c7a@10.10.10.70:8443?security=reality&pbk=2YRDBfueYmp0cOBq50tUUxQaoHCCUIkX5bLN-JIBYGg&sid=a1b2c3d4e5f60718&sni=www.microsoft.com&flow=xtls-rprx-vision&type=tcp'
    vless-reality: 'vless://4a3d42a2-a62d-4454-b2a2-7cbe5ddf4c7a@10.10.10.70:8444?security=reality&pbk=2YRDBfueYmp0cOBq50tUUxQaoHCCUIkX5bLN-JIBYGg&sid=a1b2c3d4e5f60718&sni=www.microsoft.com&type=tcp'
    vmess: 'vmess://eyJ2IjoiMiIsInBzIjoidm1lc3MiLCJhZGQiOiIxMC4xMC4xMC43MCIsInBvcnQiOiI4NDQ2IiwiaWQiOiI4MjE2NjM0NS1kMWJiLTQ4ZjgtYmQzYi1jZjBjMTUyYTg2M2MiLCJhaWQiOiIwIiwic2N5IjoiYXV0byIsIm5ldCI6InRjcCIsInR5cGUiOiJub25lIiwiaG9zdCI6IiIsInBhdGgiOiIiLCJ0bHMiOiIifQ=='
}

group {
    proxy-vless-vision {
        filter: name('vless-vision')
        policy: fixed(0)
    }
    proxy-vless-reality {
        filter: name('vless-reality')
        policy: fixed(0)
    }
    proxy-vmess {
        filter: name('vmess')
        policy: fixed(0)
    }
}

routing {
    dport(8443, 8444, 8446) -> direct(must)
    dport(5201, 8001, 53531) -> proxy-vless-vision
    dport(5202, 8002, 53532) -> proxy-vless-reality
    dport(5203, 8003, 53533) -> proxy-vmess
    fallback: direct
}

dns {
    upstream {
        alidns: 'udp://223.5.5.5:53'
    }
    routing {
        request {
            fallback: alidns
        }
    }
}

experimental {
    clash_api {
        external_controller: '127.0.0.1:9090'
    }
}
