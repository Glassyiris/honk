global {
    wan_interface: ens3
    lan_interface: veth-lab
    log_level: info
    dial_mode: ip
    allow_insecure: true
    auto_config_kernel_parameter: true
    tcp_check_url: 'http://cp.cloudflare.com,1.1.1.1,2606:4700:4700::1111'
    tcp_check_http_method: HEAD
    udp_check_dns: 'dns.google.com:53,8.8.8.8,2001:4860:4860::8888'
    check_interval: 3600s
    check_tolerance: 30ms
}

node {
    vless-vision: 'vless://e1801232-f6d5-4d7f-a9f5-2bd16ce1bab4@10.10.10.70:2448?security=reality&pbk=uyrWvu-V_J3KyVEiuvAZ_88g-b56ujFj7WIghWw5Ejc&sid=a1b2c3d4e5f60718&sni=dl.google.com&flow=xtls-rprx-vision&type=tcp#vless-vision'
    vless-reality: 'vless://efaf7323-77be-408d-8603-3a22d08205ca@10.10.10.70:2449?security=reality&pbk=uyrWvu-V_J3KyVEiuvAZ_88g-b56ujFj7WIghWw5Ejc&sid=a1b2c3d4e5f60718&sni=dl.google.com&type=tcp#vless-reality'
    vmess: 'vmess://eyJ2IjoiMiIsInBzIjoidm1lc3MiLCJhZGQiOiIxMC4xMC4xMC43MCIsInBvcnQiOiIyNDUwIiwiaWQiOiI2N2M0MDU4Yy0zMjk0LTQ4ZjUtYThhYS0zZjdjMjk1MjNjZDciLCJhaWQiOiIwIiwic2N5IjoiYXV0byIsIm5ldCI6InRjcCIsInR5cGUiOiJub25lIiwiaG9zdCI6IiIsInBhdGgiOiIiLCJ0bHMiOiIifQ=='
}

group {
    vless-vision {
        filter: name('vless-vision')
        policy: fixed(0)
    }
    vless-reality {
        filter: name('vless-reality')
        policy: fixed(0)
    }
    vmess {
        filter: name('vmess')
        policy: fixed(0)
    }
}

routing {
    dport(2448, 2449, 2450) -> direct(must)
    dport(5201, 8001, 53531) -> vless-vision
    dport(5202, 8002, 53532) -> vless-reality
    dport(5203, 8003, 53533) -> vmess
    fallback: direct
}

dns {
    upstream {
        alidns: 'udp://223.5.5.5:53'
    }
    routing {
        request {
            fallback: alidns
        }
    }
}

experimental {
    clash_api {
        external_controller: '127.0.0.1:9090'
    }
}
