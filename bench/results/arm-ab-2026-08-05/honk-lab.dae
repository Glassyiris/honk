global {
    wan_interface: end0
    lan_interface: veth-lab
    log_level: info
    dial_mode: ip
    allow_insecure: true
    auto_config_kernel_parameter: true
    tcp_check_url: 'http://cp.cloudflare.com,1.1.1.1,2606:4700:4700::1111'
    tcp_check_http_method: HEAD
    udp_check_dns: 'dns.google.com:53,8.8.8.8,2001:4860:4860::8888'
    check_interval: 3600s
    check_tolerance: 30ms
    udp_warm_node_count: 8
}

node {
    hy2: 'hysteria2://testpass123@10.10.10.70:8443/?insecure=1&mtu=1452'
    tuic: 'tuic://00000000-0000-0000-0000-000000000001:testpass123@10.10.10.70:2444/?congestion_control=cubic&alpn=tuic&sni=hy2.test&insecure=1&mtu=1452'
    ss2022: 'ss://2022-blake3-aes-128-gcm:8JCsHssyVTFyPy5lYdNhZg==@10.10.10.70:2447'
    trojan: 'trojan://testpass123@10.10.10.70:2446/?sni=hy2.test&allowInsecure=1'
    anytls-sb: 'anytls://testpass123@10.10.10.70:2445/?insecure=1&mtu=1452'
    anytls-go: 'anytls://testpass123@10.10.10.70:2443/?insecure=1&mtu=1452'
    vless-vision: 'vless://e1801232-f6d5-4d7f-a9f5-2bd16ce1bab4@10.10.10.70:2448?security=reality&pbk=uyrWvu-V_J3KyVEiuvAZ_88g-b56ujFj7WIghWw5Ejc&sid=a1b2c3d4e5f60718&sni=dl.google.com&flow=xtls-rprx-vision&type=tcp#vless-vision'
    vless-reality: 'vless://efaf7323-77be-408d-8603-3a22d08205ca@10.10.10.70:2449?security=reality&pbk=uyrWvu-V_J3KyVEiuvAZ_88g-b56ujFj7WIghWw5Ejc&sid=a1b2c3d4e5f60718&sni=dl.google.com&type=tcp#vless-reality'
    vmess: 'vmess://eyJ2IjoiMiIsInBzIjoidm1lc3MiLCJhZGQiOiIxMC4xMC4xMC43MCIsInBvcnQiOiIyNDUwIiwiaWQiOiI2N2M0MDU4Yy0zMjk0LTQ4ZjUtYThhYS0zZjdjMjk1MjNjZDciLCJhaWQiOiIwIiwic2N5IjoiYXV0byIsIm5ldCI6InRjcCIsInR5cGUiOiJub25lIiwiaG9zdCI6IiIsInBhdGgiOiIiLCJ0bHMiOiIifQ=='
}

group {
    hy2 {
        filter: name('hy2')
        policy: fixed(0)
    }
    tuic {
        filter: name('tuic')
        policy: fixed(0)
    }
    ss2022 {
        filter: name('ss2022')
        policy: fixed(0)
    }
    trojan {
        filter: name('trojan')
        policy: fixed(0)
    }
    anytls-sb {
        filter: name('anytls-sb')
        policy: fixed(0)
    }
    anytls-go {
        filter: name('anytls-go')
        policy: fixed(0)
    }
    vless-vision {
        filter: name('vless-vision')
        policy: fixed(0)
    }
    vless-reality {
        filter: name('vless-reality')
        policy: fixed(0)
    }
    vmess {
        filter: name('vmess')
        policy: fixed(0)
    }
}

routing {
    dport(8443, 2443, 2444, 2445, 2446, 2447, 2448, 2449, 2450) -> direct(must)
    dport(5201, 8001, 53531) -> hy2
    dport(5202, 8002, 53532) -> tuic
    dport(5203, 8003, 53533) -> ss2022
    dport(5204, 8004, 53534) -> trojan
    dport(5205, 8005, 53535) -> anytls-sb
    dport(5206, 8006, 53536) -> anytls-go
    dport(5207, 8007, 53537) -> vless-vision
    dport(5208, 8008, 53538) -> vless-reality
    dport(5209, 8009, 53539) -> vmess
    fallback: direct
}

dns {
    upstream {
        alidns: 'udp://223.5.5.5:53'
    }
    routing {
        request {
            fallback: alidns
        }
    }
}

experimental {
    clash_api {
        external_controller: '127.0.0.1:9090'
    }
}
